# Образец настроек СЕРВЕРА (0.25.0): только то, что на сервере не такое, как на ноутбуке. Ключей здесь нет.
#
# Остальные настройки общие — в .env.example (модели, поиск цен, вход на сайт…). Их лучше держать на ноутбуке и
# на сервере одинаковыми: тогда проверенное на ноутбуке так же работает на сервере. Где они разошлись, показывает
# «Сервер - состояние».
#
# Как используется:
# - на сервере run.sh дописывает в .env настройки, которых там ещё нет: значение — отсюда, если настройка здесь
#   есть, иначе из .env.example; уже заданные в .env значения не меняются;
# - «Сервер - состояние» сверяет .env сервера с этим файлом.
# Новая настройка, у которой на сервере другое значение, чем на ноутбуке, — и в .env.example, и сюда.

# Только compose.yml: контейнеры в своей сети Docker, порт сайта — на 127.0.0.1 сервера, в интернет — через Caddy.
# (compose.local.yml — только для ноутбука: сеть Ubuntu и прокси Windows.)
COMPOSE_FILE=compose.yml

# Папка данных сайта на сервере: база сайта, очередь задач.
DATA_DIR=/opt/supplybro-data

# Папки конкурсов — из Dropbox (контейнер dropbox, см. COMPOSE_PROFILES ниже). 12.11.2026 сайт на сервере ещё
# работает с копией /opt/supplybro-tenders — переключение на Dropbox впереди («Сервер - состояние» напоминает).
TENDERS_DIR=/opt/supplybro-dropbox/Агент

# Прокси Windows на сервере нет — сервер ходит в интернет напрямую.
BUILD_PROXY=
OUTBOUND_PROXY=

# Пакеты Debian при сборке — с основного сервера Debian (зеркало Яндекса нужно только ноутбуку).
APT_MIRROR=

# Ключи — файлами в папке secrets/ сайта на сервере (сами ключи — только там).
NOCODB_TOKEN_FILE=/opt/supplybro/secrets/API_key_NocoDB.txt
CLAUDE_KEY_FILE=/opt/supplybro/secrets/API_key_Claude.txt
DEEPSEEK_KEY_FILE=/opt/supplybro/secrets/API_key_DeepSeek.txt
YANDEX_KEY_FILE=/opt/supplybro/secrets/API_key_Yandex.txt

# Синхронизация папок конкурсов с Dropbox (rclone в контейнере dropbox; README — «Сервер: папки конкурсов через
# Dropbox»). На ноутбуке этой строки быть не должно — там Dropbox для Windows.
COMPOSE_PROFILES=dropbox
