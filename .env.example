# Образец настроек. Рабочая копия — файл .env (в GitHub не попадает).

# Какие файлы compose подключать. На этом компьютере — с добавкой compose.local.yml
# (сеть Ubuntu, чтобы был виден прокси Windows). На сервере — только compose.yml.
COMPOSE_FILE=compose.yml:compose.local.yml

# Папка данных внутри Ubuntu: база сайта, очередь задач. run.sh создаёт её сам.
DATA_DIR=/home/user_1/supplybro-data

# Папки конкурсов (Dropbox\Агент) — как их видит Ubuntu. Путь с пробелом — в кавычках.
TENDERS_DIR="/mnt/c/Users/User 1/Dropbox/Агент"

# Порт сайта на этом компьютере: http://127.0.0.1:8000
WEB_PORT=8000

# Прокси Windows для скачивания библиотек при сборке. Пусто — без прокси.
BUILD_PROXY=http://127.0.0.1:10809

# Зеркало пакетов Debian для сборки (LibreOffice, распознавание текста). Пусто — основной сервер Debian.
APT_MIRROR=mirror.yandex.ru

# Прокси для работы сайта (запросы в NocoDB, Claude, DeepSeek). Пусто — напрямую.
OUTBOUND_PROXY=http://127.0.0.1:10809

# Файлы с ключами API (папка secrets этого проекта; в GitHub и в образ не попадают).
NOCODB_TOKEN_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_NocoDB.txt
CLAUDE_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_Claude.txt
DEEPSEEK_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_DeepSeek.txt
YANDEX_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_Yandex.txt

# Анализ документов (ИИ).
# После загрузки документов через сайт сразу запускать анализ и запись в NocoDB: 1 — да, 0 — только по кнопке.
AUTO_ANALYZE=1
# Записывать результат анализа в NocoDB: 1 — да, 0 — только сохранять в папке конкурса (AIExtract).
NOCODB_WRITE=1
# Модель Claude для анализа по умолчанию (на странице можно выбрать другую рядом с кнопкой «Запустить анализ»).
# claude-haiku-5-5 — в 10–20 раз дешевле (К934: ≈ $0.07 за анализ), claude-sonnet-5-5 — точнее (К934: ≈ $0.7–1.5).
CLAUDE_MODEL=claude-haiku-5-5
# Модели анализа на выбор на странице (через запятую).
ANALYSIS_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# Насколько глубоко модель думает: low / medium / high (выше — точнее, дольше и дороже). Sonnet / Opus:
CLAUDE_EFFORT=medium
# Для Haiku отдельно: при medium она думает очень долго, low — быстро и дёшево.
HAIKU_EFFORT=low
# Если на счёте Anthropic закончились деньги — продолжать анализ и чат на DeepSeek: 1 — да, 0 — показать ошибку.
FALLBACK_TO_DEEPSEEK=1
# Какой моделью DeepSeek заменять Claude.
FALLBACK_DEEPSEEK_MODEL=deepseek-flash
# Модель DeepSeek для перепроверки важных полей: deepseek-flash (быстро, ~1 мин) или deepseek-v4-pro (на 74 тыс. токенов отвечала 12 мин).
DEEPSEEK_MODEL=deepseek-flash

# Чат по документации конкурса.
# Модель по умолчанию (claude-haiku-5-5 — быстро и дёшево; claude-sonnet-5-5 — точнее; deepseek-flash — дешевле всего).
CHAT_MODEL=claude-haiku-5-5
# Модели на выбор в чате (через запятую).
CHAT_MODELS=claude-haiku-5-5,claude-sonnet-5-5,deepseek-flash
# Сколько документы держатся в кэше Claude после последнего вопроса: 1h (час) или 5m (5 минут).
CHAT_CACHE_TTL=1h

# Поиск цен (кнопка «Искать цены» на странице конкурса).
# Модель Claude: проверяет, тот ли товар на странице магазина, и ищет предложения за рубежом.
PRICES_MODEL=claude-haiku-5-5
# Искать за рубежом (веб-поиск Claude: Германия, Китай, США), ≈ $0,06 за артикул: 1 — да (галочку можно снять на странице), 0 — никогда.
PRICES_ABROAD=1
# Сколько поисков Claude делает по одному артикулу за рубежом ($0,01 за поиск). Правило старого проекта — не меньше 5.
PRICES_ABROAD_SEARCHES=5
# Отложенный режим Яндекса: сколько минут ждать ответов, потом недостающие — мгновенным режимом (дороже).
PRICES_ASYNC_TIMEOUT_MIN=30
# Сколько страниц магазинов открывать по одному артикулу (Россия).
PRICES_MAX_PAGES=12
# Через сколько часов перечитывать свою базу цен (прошлые спецификации NocoDB).
PRICES_HISTORY_HOURS=12
# Сколько результатов Яндекса брать на один запрос.
YANDEX_RESULTS_PER_QUERY=20
