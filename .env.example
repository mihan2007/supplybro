# Образец настроек. Рабочая копия — файл .env (в GitHub не попадает).

# Какие файлы compose подключать. На этом компьютере — с добавкой compose.local.yml
# (сеть Ubuntu, чтобы был виден прокси Windows). На сервере — только compose.yml.
COMPOSE_FILE=compose.yml:compose.local.yml

# Папка данных внутри Ubuntu: база сайта, очередь задач. run.sh создаёт её сам.
DATA_DIR=/home/user_1/supplybro-data

# Папки конкурсов (Dropbox\Агент) — как их видит Ubuntu. Путь с пробелом — в кавычках.
TENDERS_DIR="/mnt/c/Users/User 1/Dropbox/Агент"

# Порт сайта на этом компьютере: http://127.0.0.1:8000
WEB_PORT=8000

# Прокси Windows для скачивания библиотек при сборке. Пусто — без прокси.
BUILD_PROXY=http://127.0.0.1:10809

# Зеркало пакетов Debian для сборки (LibreOffice, распознавание текста). Пусто — основной сервер Debian.
APT_MIRROR=mirror.yandex.ru

# Прокси для работы сайта (запросы в NocoDB, Claude, DeepSeek). Пусто — напрямую.
OUTBOUND_PROXY=http://127.0.0.1:10809

# Файлы с ключами API (папка secrets этого проекта; в GitHub и в образ не попадают).
NOCODB_TOKEN_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_NocoDB.txt
CLAUDE_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_Claude.txt
DEEPSEEK_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_DeepSeek.txt
YANDEX_KEY_FILE=/mnt/c/ClaudeProject/supplybro/secrets/API_key_Yandex.txt

# Анализ документов (ИИ).
# После загрузки документов через сайт сразу запускать анализ и запись в NocoDB: 1 — да, 0 — только по кнопке.
AUTO_ANALYZE=1
# Записывать результат анализа в NocoDB: 1 — да, 0 — только сохранять в папке конкурса (AIExtract).
NOCODB_WRITE=1
# Если номер закупки уже есть в NocoDB у другого конкурса (двойник): separate — сразу записать этот конкурс отдельной
# записью (запись-двойник не меняется), ask — не записывать, ждать кнопку «Записать всё равно» на странице.
NOCODB_DUPLICATES=separate
# После анализа сразу искать цены и дописывать их в спецификацию NocoDB: 1 — да, 0 — только по кнопке «Искать цены».
AUTO_PRICES=1
# База NocoDB для сайта (0.16.1) — адрес «Реестра конкурсов» из строки браузера целиком, например
#   NOCODB_URL_MAIN=https://app.nocodb.com/wzs963xn/py03vcjrohur7u7/m9w2qkxcvt02nkb/vwrh37vtzc3h9r0r/...
# Из адреса сайт берёт рабочее пространство, базу и таблицу реестра. Пусто — как в config/clients.json (с 0.17.2 у
# «Нашей компании» там копия базы для сайта py03vcjrohur7u7; старая база агента — pf3o1felxit8s5b / mdbebnsirecunr5).
# Спецификации — только из этой базы (ссылки в старую базу сайт заменяет таблицами с тем же названием).
# После правки: docker compose up -d (или «Запустить SupplyBro.bat»).
NOCODB_URL_MAIN=
NOCODB_URL_SARGSYAN=
# Вход на сайт по логину и паролю (0.7.0): 1 — без входа сайт не открывается, сотрудник видит только своих клиентов и
# делает то, что разрешает его роль; 0 — сайт без входа, как раньше (только на своём компьютере, НЕ на сервере).
# Учётные записи для начала (администратор и по сотруднику на клиента):
#   docker compose exec web python -m app.auth setup-accounts
# Включён — решение 03.11.2026. С 0.16.0 (сайт в интернете): без входа открывается только страница входа /login;
# если строки нет совсем — вход всё равно обязателен. Первого администратора через сайт не создать — только командой.
# При LOGIN_REQUIRED=1 админ-панель, страница сотрудника и страница входа включены всегда (три настройки ниже — для 0).
LOGIN_REQUIRED=1
# Админ-панель учётных записей сотрудников (/admin) — для LOGIN_REQUIRED=0: 1 — включена, 0 — выключена.
ADMIN_PANEL=0
# Страница сотрудника (/user) — для LOGIN_REQUIRED=0: как основная, но без выбора модели анализа, модели чата и
# поисковика цен (берутся настройки по умолчанию). 1 — включена, 0 — выключена.
USER_PAGE=0
# Страница входа (/login) — для LOGIN_REQUIRED=0: проверка логина и пароля сотрудников. 1 — включена, 0 — выключена.
LOGIN_PAGE=0
# Модель Claude для анализа по умолчанию (на странице можно выбрать другую рядом с кнопкой «Запустить анализ»).
# claude-haiku-5-5 — в 10–20 раз дешевле (К934: ≈ $0.07 за анализ), claude-sonnet-5-5 — точнее (К934: ≈ $0.7–1.5).
CLAUDE_MODEL=claude-haiku-5-5
# Модели анализа на выбор на странице (через запятую).
ANALYSIS_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# Насколько глубоко модель думает: low / medium / high (выше — точнее, дольше и дороже). Sonnet / Opus:
CLAUDE_EFFORT=medium
# Для Haiku отдельно: при medium она думает очень долго, low — быстро и дёшево.
HAIKU_EFFORT=low
# Если на счёте Anthropic закончились деньги — продолжать анализ и чат на DeepSeek: 1 — да, 0 — показать ошибку.
FALLBACK_TO_DEEPSEEK=1
# Какой моделью DeepSeek заменять Claude.
FALLBACK_DEEPSEEK_MODEL=deepseek-flash
# Модель DeepSeek для перепроверки важных полей: deepseek-flash (быстро, ~1 мин) или deepseek-v4-pro (на 74 тыс. токенов отвечала 12 мин).
DEEPSEEK_MODEL=deepseek-flash

# Чат по документации конкурса.
# Модель по умолчанию (claude-haiku-5-5 — быстро и дёшево; claude-sonnet-5-5 — точнее; deepseek-flash — дешевле всего).
CHAT_MODEL=claude-haiku-5-5
# Модели на выбор в чате (через запятую).
CHAT_MODELS=claude-haiku-5-5,claude-sonnet-5-5,deepseek-flash
# Сколько документы держатся в кэше Claude после последнего вопроса: 1h (час) или 5m (5 минут).
CHAT_CACHE_TTL=1h

# Поиск цен (кнопка «Искать цены» на странице конкурса).
# Чем искать по России: deepseek (по умолчанию: поиск DeepSeek, ≈ 0,06 ₽ за запрос, ответ за секунду; ключ — тот же,
# что DEEPSEEK_KEY_FILE), yandex (Yandex Search API, нужен YANDEX_KEY_FILE), both (оба — сравнить). На странице можно выбрать.
PRICES_SEARCH=deepseek
# Модель, которая проверяет, тот ли товар на странице магазина, и цену за единицу: claude-haiku-5-5 или deepseek-flash.
PRICES_JUDGE_MODEL=claude-haiku-5-5
# Искать за рубежом (поиском DeepSeek: «артикул price / Preis / 价格»): 1 — да (галочку можно снять на странице), 0 — никогда.
PRICES_ABROAD=1
# Дополнительно искать за рубежом веб-поиском Claude (≈ $0,05 за артикул): 0 — нет, 1 — да.
PRICES_CLAUDE_ABROAD=0
# Модель и число поисков Claude для этого (если PRICES_CLAUDE_ABROAD=1).
PRICES_MODEL=claude-haiku-5-5
PRICES_ABROAD_SEARCHES=5
# Отложенный режим Яндекса: сколько минут ждать ответов, потом недостающие — мгновенным режимом (дороже).
PRICES_ASYNC_TIMEOUT_MIN=30
# Сколько страниц магазинов открывать по одному артикулу: российских и прочих (зарубеж, сайты не .ru).
PRICES_MAX_PAGES=12
PRICES_MAX_ABROAD_PAGES=10
# Страницы, которые программа сама не открыла, открывает DeepSeek (≈ 0,06 ₽ за страницу): сколько на артикул и всего.
PRICES_DS_FETCH_PER_ITEM=4
PRICES_DS_FETCH_PAGES=150
# Цена дороже НМЦ за единицу больше чем в 10 раз или дешевле 15 % НМЦ — в цены не идёт (лот, деталь, порог доставки,
# другой товар); такие предложения перечислены в «Как искали».
PRICES_MAX_RATIO=10
PRICES_MIN_RATIO=0.15
# Через сколько часов перечитывать свою базу цен (прошлые спецификации NocoDB).
PRICES_HISTORY_HOURS=12
# Сколько результатов брать на один запрос: DeepSeek (до 50), Яндекс.
DEEPSEEK_SEARCH_COUNT=50
YANDEX_RESULTS_PER_QUERY=20

# --- Изменения и разъяснения к разобранному конкурсу (0.9.0) ---
# Модель, которая читает дозагруженные документы и находит изменения (пусто — как у анализа, CLAUDE_MODEL).
CHANGES_MODEL=

# --- Подготовка заявки (0.15.0): кнопка «Подготовить документы заявки» ---
# Модель, которая читает документацию и сведения участника и заполняет формы (0.15.1 — DeepSeek по умолчанию:
# пользователь 05.11.2026 «модели Claude оказались очень прожорливые»). К933: deepseek-flash ≈ $0,1 и 3–4 минуты,
# claude-sonnet-5-5 ≈ $1,5–2 и 7 минут, формы почти одинаковые. Ещё: deepseek-v4-pro, claude-haiku-5-5,
# claude-opus-5-5 — администратор может выбрать на странице. Повторная подготовка тех же документов — дешевле.
BID_MODEL=deepseek-flash
# Сколько форм заполнять одновременно и сколько форм не больше в одном пакете.
BID_PARALLEL=4
BID_MAX_FORMS=30

# --- Прайсы, КП и счета поставщиков (0.8.0): загрузка через чат (📎) ---
# Модель, которая читает документ поставщика и находит в нём позиции конкурса.
PRICELIST_MODEL=claude-haiku-5-5
